-- TETHYS WILDBOUND: DYNAMIC DAY/NIGHT & CRETACEOUS WEATHER SYSTEM
-- Drives atmospheric mood shifts with smooth transitions and low-overhead updates.

local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local DAY_DURATION_SEC = 240
local TIME_SPEED = 24 / DAY_DURATION_SEC

local WEATHER_ROTATION_INTERVAL = 80
local WEATHER_TRANSITION_SEC = 8

local NIGHT_START = 18.5
local NIGHT_END = 5.5

local function getAsset(className, name)
	local asset = Lighting:FindFirstChild(name)
	if asset and asset.ClassName ~= className then
		asset:Destroy()
		asset = nil
	end
	if not asset then
		asset = Instance.new(className)
		asset.Name = name
		asset.Parent = Lighting
	end
	return asset
end

local atmosphere = getAsset("Atmosphere", "Tethys_Atmosphere")
local colorCorrection = getAsset("ColorCorrectionEffect", "Tethys_Color")
local sunRays = getAsset("SunRaysEffect", "Tethys_SunRays")

local weatherPresets = {
	ClearGreenhouse = {
		Ambient = Color3.fromRGB(45, 45, 40),
		OutdoorAmbient = Color3.fromRGB(135, 130, 115),
		Brightness = 2.0,
		FogDensity = 0.62,
		FogColor = Color3.fromRGB(225, 215, 190),
		Haze = 2.5,
		Contrast = 0.08,
		Saturation = 0.15,
		SunRays = 0.35,
	},
	AshfallDusk = {
		Ambient = Color3.fromRGB(25, 22, 20),
		OutdoorAmbient = Color3.fromRGB(80, 70, 60),
		Brightness = 1.45,
		FogDensity = 0.82,
		FogColor = Color3.fromRGB(130, 105, 90),
		Haze = 3.2,
		Contrast = 0.15,
		Saturation = -0.3,
		SunRays = 0.05,
	},
	TorrentialStorm = {
		Ambient = Color3.fromRGB(15, 15, 20),
		OutdoorAmbient = Color3.fromRGB(40, 45, 55),
		Brightness = 1.1,
		FogDensity = 0.88,
		FogColor = Color3.fromRGB(85, 95, 100),
		Haze = 3.6,
		Contrast = 0.18,
		Saturation = -0.2,
		SunRays = 0,
	},
}

local currentWeather = "ClearGreenhouse"
local lastWeatherChange = os.clock()
local activeTweens = {}
local nightTick = 0
local lastNightBlend = -1
local nextStormFlashAt = os.clock() + math.random(6, 12)

local function cancelTweens()
	for _, tween in ipairs(activeTweens) do
		pcall(function()
			tween:Cancel()
		end)
	end
	table.clear(activeTweens)
end

local function queueTween(instance, tweenInfo, properties)
	local tween = TweenService:Create(instance, tweenInfo, properties)
	table.insert(activeTweens, tween)
	tween:Play()
end

local function applyPreset(stateName, immediate)
	local preset = weatherPresets[stateName]
	if not preset then
		return
	end

	currentWeather = stateName
	Lighting:SetAttribute("WB_WeatherState", stateName)

	cancelTweens()

	if immediate then
		Lighting.Ambient = preset.Ambient
		Lighting.OutdoorAmbient = preset.OutdoorAmbient
		Lighting.Brightness = preset.Brightness
		atmosphere.Density = preset.FogDensity
		atmosphere.Color = preset.FogColor
		atmosphere.Haze = preset.Haze
		colorCorrection.Contrast = preset.Contrast
		colorCorrection.Saturation = preset.Saturation
		sunRays.Intensity = preset.SunRays
		return
	end

	local tweenInfo = TweenInfo.new(WEATHER_TRANSITION_SEC, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	queueTween(Lighting, tweenInfo, {
		Ambient = preset.Ambient,
		OutdoorAmbient = preset.OutdoorAmbient,
		Brightness = preset.Brightness,
	})
	queueTween(atmosphere, tweenInfo, {
		Density = preset.FogDensity,
		Color = preset.FogColor,
		Haze = preset.Haze,
	})
	queueTween(colorCorrection, tweenInfo, {
		Contrast = preset.Contrast,
		Saturation = preset.Saturation,
	})
	queueTween(sunRays, tweenInfo, {
		Intensity = preset.SunRays,
	})
end

local function computeNightBlend(clockTime)
	if clockTime >= NIGHT_START then
		return math.clamp((clockTime - NIGHT_START) / (24 - NIGHT_START), 0, 1)
	end
	if clockTime <= NIGHT_END then
		return math.clamp((NIGHT_END - clockTime) / NIGHT_END, 0, 1)
	end
	return 0
end

local function applyNightLayer()
	local preset = weatherPresets[currentWeather]
	if not preset then
		return
	end

	local blend = computeNightBlend(Lighting.ClockTime)
	if math.abs(blend - lastNightBlend) < 0.03 then
		return
	end
	lastNightBlend = blend

	local nightAmbient = Color3.fromRGB(5, 5, 10)
	local nightOutdoor = Color3.fromRGB(22, 24, 32)
	Lighting.Ambient = preset.Ambient:Lerp(nightAmbient, blend)
	Lighting.OutdoorAmbient = preset.OutdoorAmbient:Lerp(nightOutdoor, blend * 0.85)

	local fogColor = preset.FogColor
	local fogDensity = preset.FogDensity
	if currentWeather == "ClearGreenhouse" then
		fogColor = fogColor:Lerp(Color3.fromRGB(40, 45, 60), blend)
		fogDensity = math.clamp(fogDensity + (0.1 * blend), 0, 1)
	else
		fogDensity = math.clamp(fogDensity + (0.05 * blend), 0, 1)
	end

	atmosphere.Color = fogColor
	atmosphere.Density = fogDensity
end

local function chooseNextWeather()
	local roll = math.random()
	if roll < 0.4 then
		return "ClearGreenhouse"
	end
	if roll < 0.75 then
		return "AshfallDusk"
	end
	return "TorrentialStorm"
end

local function triggerStormFlash()
	if currentWeather ~= "TorrentialStorm" then
		return
	end

	local baseBrightness = weatherPresets.TorrentialStorm.Brightness
	local flashUp = TweenService:Create(Lighting, TweenInfo.new(0.08, Enum.EasingStyle.Linear, Enum.EasingDirection.Out), {
		Brightness = baseBrightness + 0.95,
	})
	local flashDown = TweenService:Create(Lighting, TweenInfo.new(0.26, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Brightness = baseBrightness,
	})
	flashUp.Completed:Connect(function()
		flashDown:Play()
	end)
	flashUp:Play()
end

Lighting.ClockTime = 6
Lighting.GlobalShadows = true
applyPreset(currentWeather, true)
applyNightLayer()

RunService.Heartbeat:Connect(function(deltaTime)
	Lighting.ClockTime = (Lighting.ClockTime + (deltaTime * TIME_SPEED)) % 24

	nightTick += deltaTime
	if nightTick >= 0.25 then
		nightTick = 0
		applyNightLayer()
	end

	local now = os.clock()
	if now - lastWeatherChange >= WEATHER_ROTATION_INTERVAL then
		lastWeatherChange = now
		local nextWeather = chooseNextWeather()
		if nextWeather == currentWeather then
			nextWeather = nextWeather == "ClearGreenhouse" and "AshfallDusk" or "ClearGreenhouse"
		end
		applyPreset(nextWeather, false)
		nextStormFlashAt = now + math.random(4, 9)
	end

	if currentWeather == "TorrentialStorm" and now >= nextStormFlashAt then
		nextStormFlashAt = now + math.random(4, 9)
		triggerStormFlash()
	end
end)
