# Publish an explicit code portfolio; local world material remains available.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/src/
!/plugins/
!/tests/
!/tools/
!/docs/
!/.github/
node_modules/
dist/
.env
.DS_Store
*.log

/docs/*
!/docs/engineering/
!/docs/media/
/tools/*
!/tools/*.luau
!/tools/ordovic/
!/tools/ui/
!/tools/ci_checks.py
!/tools/install_luau.py
!/tools/luau-release.json
!/tools/package_terrain_plugin.py

# Secrets, local tooling, generated Studio files and temporary test adapters.
**/.DS_Store
**/.env
**/.env.*
**/*.pem
**/*.key
**/__pycache__/
**/.tooling/
**/.portable_*.luau
**/*.rbxl
**/*.rbxlx
**/*.rbxm
**/*.rbxmx
**/*.pdf
**/*.pages
**/*~

# Reproducible integration configuration and source, without generated output.
!/package.json
!/package-lock.json
!/tsconfig.json
!/tsconfig.api.json
!/tsconfig.test.json
!/default.project.json
!/roblox-ts.project.json
!/jest.config.cjs
!/backend/
!/.env.example
out/
include/
coverage/
**/*.tsbuildinfo

!/tools/map_slicer.py
!/tools/generate_heightmap_samples.py
!/tools/heightmaps-requirements.txt
