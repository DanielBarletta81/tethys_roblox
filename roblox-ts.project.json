{
  "name": "WorldOfTethys",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "TethysSystems": {
        "$className": "Folder",
        "$attributes": {
          "AquaponicsEnabled": false,
          "JusticeEnabled": false
        },
        "Events": {
          "$className": "Folder",
          "TerminalAction": {
            "$className": "RemoteEvent"
          },
          "FetchTerminalData": {
            "$className": "RemoteFunction"
          },
          "UpdateCityEcology": {
            "$className": "RemoteEvent"
          },
          "ExecutionUI": {
            "$className": "RemoteEvent"
          },
          "VarekConscription": {
            "$className": "RemoteEvent"
          }
        },
        "Shared": {
          "$path": "out/shared"
        }
      },
      "rbxts_include": {
        "$path": "include",
        "node_modules": {
          "$className": "Folder",
          "@rbxts": {
            "$path": "node_modules/@rbxts"
          }
        }
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$ignoreUnknownInstances": true,
      "TethysSystems": {
        "$path": "out/server"
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage"
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$ignoreUnknownInstances": true,
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$ignoreUnknownInstances": true,
        "TethysSystems": {
          "$path": "out/client"
        }
      }
    },
    "StarterGui": {
      "$className": "StarterGui",
      "$ignoreUnknownInstances": true
    }
  }
}
