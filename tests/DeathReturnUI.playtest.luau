-- Client-only fixture. Exercises production UI with a private attribute source; never grants XP.
local Return = require(game.ReplicatedStorage.WildboundUI.Controllers.ReturnController)
local player = Instance.new("Folder")
local ui = Instance.new("ScreenGui"); ui.Name, ui.ResetOnSpawn, ui.IgnoreGuiInset = "ReturnUIFixture", false, true
local interaction = Instance.new("Frame"); interaction.Name, interaction.Size, interaction.BackgroundTransparency, interaction.Parent = "InteractionUI", UDim2.fromScale(1,1), 1, ui
ui.Parent = game.Players.LocalPlayer.PlayerGui
local closed, results = 0, {}
local controller = Return.new(player, ui, function() closed += 1 end)
local function test(name, fn)
	local ok, err = pcall(fn); table.insert(results, {name=name, passed=ok, error=not ok and tostring(err) or nil})
	assert(ok, name .. ": " .. tostring(err))
end
local ok, err = pcall(function()
	test("Positive cue displays the restrained wording and closes menus", function()
		player:SetAttribute("WB_DeathExperience",11);player:SetAttribute("WB_DeathExperienceRevision",1);task.wait(0.25)
		assert(controller.Frame.Visible and controller.Frame.TL_ReturnTitle.Text=="Tethys got you.")
		assert(controller.Message.Text=="+11 Experience — exploration" and closed==1)
	end)
	test("Return captures no input and fits the viewport", function()
		assert(not controller.Frame.Active and not controller.Frame.Selectable and controller.Frame.AbsoluteSize.X<=420)
		assert(controller.Message.TextBounds.X<=controller.Message.AbsoluteSize.X and controller.Message.TextBounds.Y<=controller.Message.AbsoluteSize.Y)
	end)
	test("Duplicate revision does not replay or close menus twice", function()
		local token=controller.Token;player:SetAttribute("WB_DeathExperienceRevision",1)
		assert(controller.Token==token and closed==1)
	end)
	test("Reduced motion immediately cancels a running fade", function()
		ui:SetAttribute("WB_ReducedMotion",true);task.wait()
		assert(#controller.Effects.Tweens==0 and controller.Frame.TL_ReturnTitle.TextTransparency==0)
	end)
	task.wait(2)
	test("Zero award carries experience forward without a zero-XP popup", function()
		player:SetAttribute("WB_DeathExperience",0);player:SetAttribute("WB_DeathExperienceRevision",2)
		task.wait()
		assert(controller.Message.Text=="Experience carried forward." and closed==2)
	end)
	task.wait(4)
	test("An older expiration cannot hide a newer cue", function() assert(controller.Frame.Visible and ui:GetAttribute("WB_ReturnNoticeActive")) end)
	task.wait(2.2)
	test("The six-second cue clears and destruction disconnects it", function()
		assert(not controller.Frame.Visible and ui:GetAttribute("WB_ReturnNoticeActive")==false)
		ui:Destroy();local token=controller.Token;player:SetAttribute("WB_DeathExperienceRevision",3);assert(controller.Token==token)
	end)
end)
ui:Destroy();player:Destroy()
assert(ok,tostring(err))
return results
