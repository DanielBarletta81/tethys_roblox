{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "jest"
    ],
    "noEmit": true
  },
  "include": [
    "backend/**/*.ts"
  ],
  "exclude": [
    "backend/**/*.test.ts"
  ]
}
